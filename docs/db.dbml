Project ground_guard {
  database_type: 'PostgreSQL'
  Note: '''
    # Ground Guard Database
  '''
}
Table users as U {
  id bigserial [pk]
  uuid UUID [unique, default: `gen_random_uuid()`]
  username varchar [not null]
  hashed_password varchar [not null]
  full_name varchar [not null]
  email varchar [unique, not null]
  password_changed_at timestampz [not null, default: '0001-01-01 00:00:00Z']
  created_at timestamptz [not null, default: `now()`]
  profile_image varchar(255)
}

Table sessions as S {
  id UUID [pk]
  user_id bigint [ref: > U.id]
  refresh_token varchar [not null]
  user_agent varchar [not null]
  client_ip varchar [not null]
  is_blocked boolean [not null, default: true]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table devices as D {
  id bigserial [pk]
  uuid UUID [unique, default: `gen_random_uuid()`]
  device_uid varchar(100) [unique]
  name varchar(100)
  firmware_version varchar(50)
  firmware_build varchar(50)
  last_update timestamptz
  ip_address inet
  qr_token varchar(64) [unique, not null]
  qr_code_file varchar(255) 
  wifi_ssid varchar(100) 
  last_seen timestamptz
  status varchar(20)
  user_id bigint [ref: > U.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id)
    (device_uid) [unique]
    (uuid) [unique]
  }
}

Table irrigation_actions as IA {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  device_id bigint [not null, ref: > D.id]
  user_id bigint [not null, ref: > U.id]

  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  duration_seconds integer

  status varchar(20) [not null, default: 'ATIVO']
  trigger_type varchar(20) [not null]

  water_volume_ml integer

  error_message text

  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (device_id)
    (user_id)
    (started_at)
    (uuid) [unique]
  }
}

Table irrigation_preferences as IP {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  device_id bigint [not null, unique, ref: > D.id]

  enabled boolean [not null, default: true]

  irrigation_mode varchar(20) [not null, default: 'INTELIGENTE']
  // INTELIGENTE | MANUAL

  moisture_threshold integer [not null, default: 30]
  // porcentagem de umidade mínima

  dry_time_minutes integer [not null, default: 10]
  // quanto tempo deve permanecer seco antes de irrigar

  irrigation_duration_seconds integer [not null, default: 60]
  // tempo de irrigação

  max_irrigations_per_day integer [not null, default: 10]

  start_hour time
  end_hour time
  // janela permitida para irrigação

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (device_id) [unique]
    (uuid) [unique]
  }
}

Table irrigation_preferences_history as IPH {
  id bigserial [pk]

  preference_id bigint [not null, ref: > IP.id]
  user_id bigint [not null, ref: > U.id]

  old_data jsonb
  new_data jsonb

  changed_at timestamptz [not null, default: `now()`]
}

Table help_contents as HC {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  title varchar(200) [not null]
  slug varchar(200) [unique, not null]
  category varchar(50) [not null]
  content text [not null]

  image_url varchar(255)

  published boolean [not null, default: true]
  order_number integer [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (uuid) [unique]
    (category)
    (slug) [unique]
  }
}

Table faqs as FAQ {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  question varchar(255) [not null]
  answer text [not null]

  category varchar(100)

  published boolean [not null, default: true]
  order_number integer [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (uuid) [unique]
    (category)
  }
}

Table tutorials as T {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  title varchar(200) [not null]
  description text

  content text [not null]

  image_url varchar(255)
  video_url varchar(255)

  category varchar(100)

  published boolean [not null, default: true]
  order_number integer [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (uuid) [unique]
    (category)
  }
}

Table legal_documents as LD {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  type varchar(50) [not null]
  // TERMS | PRIVACY

  version varchar(20) [not null]

  title varchar(200) [not null]
  content text [not null]

  active boolean [not null, default: true]

  published_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (uuid) [unique]
    (type)
    (active)
  }
}

Table user_accepted_terms as UAT {
  id bigserial [pk]
  uuid UUID [unique, not null, default: `gen_random_uuid()`]

  user_id bigint [not null, ref: > U.id]
  legal_document_id bigint [not null, ref: > LD.id]

  accepted_at timestamptz [not null, default: `now()`]

  Indexes {
    (uuid) [unique]
    (user_id)
    (legal_document_id)
  }
}